{
  "name": "loliking-tech-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "astro": "ASTRO_TELEMETRY_DISABLED=1 node ./node_modules/astro/bin/astro.mjs",
    "dev": "npm run astro -- dev",
